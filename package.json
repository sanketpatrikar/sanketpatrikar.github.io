{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build && node scripts/generate-rss.ts",
    "deploy:cloudflare": "pnpm build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && node scripts/check-build.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.8",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.31",
    "@tanstack/router-plugin": "1.168.22",
    "lucide-react": "^1.25.0",
    "nitro": "latest",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-tweet": "^3.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.5",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "web-vitals": "^5.3.0",
    "wrangler": "4.127.1"
  },
  "packageManager": "pnpm@12.0.0-rc.7"
